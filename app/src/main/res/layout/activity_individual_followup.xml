<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/activity_deal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context="com.scg.rtmssf.IndividualFollowupActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:background="#fce9ec">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"

            >

            <!--<TextView
                android:layout_width="match_parent"
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_height="wrap_content"
                android:id="@+id/productNamePrice"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/productImageView"
                android:layout_below="@id/productNamePrice"/>-->

            <!--<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#000000"
                android:id="@+id/DetailsLabel"
                android:text="Sale Details"
                android:layout_below="@id/productImageView"
                />-->
            <!--<Switch
                android:layout_width="wrap_content"
                android:layout_below="@id/DetailsLabel"
                android:layout_height="wrap_content"
                android:id="@+id/ShopDeliverySwitch"
                android:textOff="Delivery"
                android:textOn="Shop"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I want it delivered"
                android:layout_below="@id/ShopDeliverySwitch"
                android:id="@+id/shopDelivery"
                android:textSize="17sp"/>
            -->
            <LinearLayout
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/addressShopLayout">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:id="@+id/addressLayout"
                    android:layout_height="wrap_content">
                    <!--
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:id="@+id/AddressLabel"
                        android:text="New Address"
                        android:layout_below="@id/productImageView"
                        />-->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/outletNameLayout"
                        >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/outletName"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Outlet Name"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="textMultiLine"
                            android:id="@+id/outletNameText"
                            android:nextFocusDown="@+id/phoneText"
                            android:layout_weight="1"
                            android:textColor="#000000"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/imageView"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Outlet Name"
                            android:padding="8dp"/>


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/typeLayout"
                        >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/type"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Type"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="textMultiLine"
                            android:id="@+id/typeText"
                            android:nextFocusDown="@+id/phoneText"
                            android:layout_weight="1"
                            android:textColor="#000000"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/imageView"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Type"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/statusLayout"
                        >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/status"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Status"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="textMultiLine"
                            android:id="@+id/statusText"
                            android:nextFocusDown="@+id/phoneText"
                            android:layout_weight="1"
                            android:textColor="#000000"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/imageView"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Status"
                            android:padding="8dp"/>







                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/dateScheduledLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/dateScheduledTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Date"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/dateText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Date"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/timeScheduledLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/timeTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Time"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/timeText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Time"
                            android:padding="8dp"/>


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/dateCreatedLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/dateCreatedTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Date and Time"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/dateTimeText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Date Time"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <!--<Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text= "OR CHOOSE FROM PREVIOUS ADDRESSES"
                        android:id="@+id/savedAddressesButton"
                        android:textColor="#ffffff"
                        android:background="@color/colorPrimary"
                        android:layout_marginTop="5dp"
                        android:layout_below="@id/deliveryDetailsText"/>-->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/followupLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/followupTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Description"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />



                    </LinearLayout>

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:inputType="textMultiLine"
                        android:id="@+id/descriptionText"
                        android:textColor="#000000"
                        android:nextFocusDown="@+id/submitDealButton"
                        android:layout_weight="1"
                        android:gravity="top"
                        android:minLines="10"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_background"
                        android:ems="10"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentStart="true"
                        android:hint="Description"
                        android:padding="8dp"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/editFollowupButton"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginLeft="-4dp"
                    android:layout_marginRight="-4dp"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:background="@drawable/btn_rounded_primary"
                    android:text="EDIT FOLLOWUP"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                    android:textColor="@android:color/white" />


            </LinearLayout>










        </RelativeLayout>
    </ScrollView>

</RelativeLayout>
