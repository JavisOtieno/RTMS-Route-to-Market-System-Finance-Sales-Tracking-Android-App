                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/NameLayout"
                        >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/productName"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Product Name"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="textMultiLine"
                            android:id="@+id/productNameText"
                            android:nextFocusDown="@+id/skuText"
                            android:layout_weight="1"
                            android:textColor="#000000"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/imageView"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Product Name"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/targetLayout"
                        android:visibility="gone"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/targetTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Target"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/targetText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Target"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/currentLayout"
                        android:visibility="gone"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/currentTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Current Month"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/currentQtyAmountText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Month Sales"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/SKULayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/skuTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="SKU"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/skuText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="SKU"
                            android:padding="8dp"/>


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/priceLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/priceTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Price"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/priceText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Price"
                            android:padding="8dp"/>


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/stockLayout"
                        android:layout_below="@+id/priceLayout">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/stockTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Stock"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/stockText"
                            android:nextFocusDown="@+id/descriptionText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Stock"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/imageLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/imageTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Image"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />


                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/thumbnail_card"
                            android:layout_marginLeft="5dp"
                            android:layout_marginTop="@dimen/spacing_middle"
                            android:layout_marginBottom="@dimen/spacing_middle"
                            android:layout_weight="1"
                            card_view:cardCornerRadius="5dp"
                            card_view:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/productImageView"
                                android:layout_width="match_parent"
                                android:layout_height="250dp"
                                android:padding="5dp"
                                android:background="#ffffff"
                                android:src="@drawable/ic_location" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

