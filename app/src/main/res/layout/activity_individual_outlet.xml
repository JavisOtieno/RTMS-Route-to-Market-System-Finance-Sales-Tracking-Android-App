<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/activity_deal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.scg.sf.IndividualOutletActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:background="#fce9ec">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"

            >

            <!--<TextView
                android:layout_width="match_parent"
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_height="wrap_content"
                android:id="@+id/productNamePrice"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/productImageView"
                android:layout_below="@id/productNamePrice"/>-->

            <!--<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#000000"
                android:id="@+id/DetailsLabel"
                android:text="Sale Details"
                android:layout_below="@id/productImageView"
                />-->
            <!--<Switch
                android:layout_width="wrap_content"
                android:layout_below="@id/DetailsLabel"
                android:layout_height="wrap_content"
                android:id="@+id/ShopDeliverySwitch"
                android:textOff="Delivery"
                android:textOn="Shop"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I want it delivered"
                android:layout_below="@id/ShopDeliverySwitch"
                android:id="@+id/shopDelivery"
                android:textSize="17sp"/>
            -->
            <LinearLayout
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/addressShopLayout">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:id="@+id/addressLayout"
                    android:layout_height="wrap_content">
                    <!--
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:id="@+id/AddressLabel"
                        android:text="New Address"
                        android:layout_below="@id/productImageView"
                        />-->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/NameLayout"
                        >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/outletName"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Outlet Name"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:id="@+id/outletNameText"
                            android:nextFocusDown="@+id/skuText"
                            android:layout_weight="1"
                            android:inputType="textMultiLine"
                            android:textColor="#000000"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/imageView"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Outlet Name"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/ContactPersonLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/contactPersonTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Contact Name"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="textMultiLine"
                            android:textColor="#000000"
                            android:id="@+id/contactPersonText"
                            android:nextFocusDown="@+id/contactPersonText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Contact Person Name"
                            android:padding="8dp"/>


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/contactPersonPhoneLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/contactPersonPhoneTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Contact Phone"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/contactPersonPhoneText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Contact Person Phone"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/contactButtonLayout"
                        android:layout_below="@+id/imageView">

<!--                        <TextView-->
<!--                            android:layout_width="match_parent"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:id="@+id/contactButtonTextView"-->
<!--                            android:layout_marginTop="8dp"-->
<!--                            android:ems="10"-->
<!--                            android:layout_alignParentLeft="true"-->
<!--                            android:layout_alignParentStart="true"-->
<!--                            android:text="Contact"-->
<!--                            android:layout_weight="2"-->
<!--                            android:layout_marginRight="5dp"-->
<!--                            android:padding="8dp"-->
<!--                            />-->
                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text= "Contact"
                            android:layout_weight="1"
                            android:id="@+id/contactButton"
                            android:textColor="#ffffff"
                            android:background="@drawable/btn_rounded_primary"
                            android:layout_marginTop="5dp"
                            android:layout_below="@id/longLayout"/>



                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/latLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/latTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Lat"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/latText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Lat"
                            android:padding="8dp"/>


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/longLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/longTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Long"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/longText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Long"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text= "View on Google Maps"
                        android:id="@+id/viewOnGoogleMapsButton"
                        android:textColor="#ffffff"
                        android:background="@drawable/btn_rounded_primary"
                        android:layout_marginTop="5dp"
                        android:layout_below="@id/longLayout"/>





                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/imageLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/imageTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Image"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />


                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/thumbnail_card"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="@dimen/spacing_middle"
                        android:layout_marginBottom="@dimen/spacing_middle"
                        android:layout_weight="1"
                        card_view:cardCornerRadius="5dp"
                        card_view:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/outletImageView"
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:padding="5dp"
                            android:background="#ffffff"
                            android:src="@drawable/ic_location" />
                    </androidx.cardview.widget.CardView>
                    </LinearLayout>



                </LinearLayout>


            </LinearLayout>










        </RelativeLayout>
    </ScrollView>

</RelativeLayout>
