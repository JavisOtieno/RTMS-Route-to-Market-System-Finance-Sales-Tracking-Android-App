                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I want it delivered"
                android:layout_below="@id/ShopDeliverySwitch"
                android:id="@+id/shopDelivery"
                android:textSize="17sp"/>
            -->
            <LinearLayout
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/addressShopLayout">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:id="@+id/addressLayout"
                    android:layout_height="wrap_content">
                    <!--
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:id="@+id/AddressLabel"
                        android:text="New Address"
                        android:layout_below="@id/productImageView"
                        />-->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/OutletNameLayout"
                        >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/outletNameTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Outlet Name"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="textMultiLine"
                            android:id="@+id/outletNameText"
                            android:nextFocusDown="@+id/skuText"
                            android:layout_weight="1"
                            android:textColor="#000000"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/imageView"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Product Name"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/CheckinTimeLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/checkinTimeTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Checkin Time"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/checkinText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Checkin Time"
                            android:padding="8dp"/>


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/checkOutTimeLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/checkOutTimeTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Checkout Time"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/checkoutText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Checkout Time"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/durationLayout"
                        android:layout_below="@+id/imageView">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/durationTextView"
                            android:layout_marginTop="8dp"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:text="Duration"
                            android:layout_weight="2"
                            android:layout_marginRight="5dp"
                            android:padding="8dp"
                            />
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:id="@+id/durationText"
                            android:nextFocusDown="@+id/emailText"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:ems="10"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:hint="Duration"
                            android:padding="8dp"/>


                    </LinearLayout>

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text= "View Sales"
                        android:id="@+id/viewSalesButton"
                        android:textColor="#ffffff"
                        android:background="@drawable/btn_rounded_primary"
                        android:layout_marginTop="10dp"
                        android:layout_below="@id/durationLayout"/>


<!--                    <Button-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text= "View POS Audits"-->
<!--                        android:id="@+id/viewPOSAuditsButton"-->
<!--                        android:textColor="#ffffff"-->
<!--                        android:background="@drawable/btn_rounded_primary"-->
<!--                        android:layout_marginTop="5dp"-->
<!--                        android:layout_below="@id/durationLayout"/>-->

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text= "View Competitive Analysis"
                        android:id="@+id/viewCompetitiveAnalysisButton"
                        android:textColor="#ffffff"
                        android:background="@drawable/btn_rounded_primary"
                        android:layout_marginTop="5dp"
                        android:layout_below="@id/durationLayout"/>

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text= "View Feedback"
                        android:id="@+id/viewFeedbackButton"
                        android:textColor="#ffffff"
                        android:background="@drawable/btn_rounded_primary"
                        android:layout_marginTop="5dp"
                        android:layout_below="@id/feedbackLayout"/>

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text= "View on Map"
                        android:id="@+id/viewOnMapsButton"
                        android:textColor="#ffffff"
                        android:background="@drawable/btn_rounded_blue"
                        android:layout_marginTop="5dp"
                        android:layout_below="@id/longLayout"/>



                    <!--<Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text= "OR CHOOSE FROM PREVIOUS ADDRESSES"
                        android:id="@+id/savedAddressesButton"
                        android:textColor="#ffffff"
                        android:background="@color/colorPrimary"
                        android:layout_marginTop="5dp"
                        android:layout_below="@id/deliveryDetailsText"/>-->


                </LinearLayout>


            </LinearLayout>










        </RelativeLayout>
    </ScrollView>

</RelativeLayout>
