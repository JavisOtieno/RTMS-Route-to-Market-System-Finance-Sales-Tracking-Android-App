<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddCompetitiveAnalysisActivity"
    >

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/toolbar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_5"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_mlarge"
        android:scrollbars="none"
        android:scrollingCache="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="Brand Visibility"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="@color/grey_60" />

            <EditText
                style="@style/EditText.Flat.Grey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_text_round_bg_white"
                android:inputType="textMultiLine"
                android:maxLines="12"
                android:minLines="7"
                android:id="@+id/brandVisibilityEditText"
                android:minHeight="@dimen/spacing_xmlarge"
                android:paddingLeft="@dimen/spacing_middle"
                android:paddingRight="@dimen/spacing_middle"
                android:gravity="top"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="horizontal">

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="Pricing"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="@color/grey_60" />

            <EditText
                style="@style/EditText.Flat.Grey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_text_round_bg_white"
                android:inputType="textMultiLine"
                android:maxLines="12"
                android:minLines="7"
                android:id="@+id/pricingEditText"
                android:minHeight="@dimen/spacing_xmlarge"
                android:paddingLeft="@dimen/spacing_middle"
                android:paddingRight="@dimen/spacing_middle"
                android:gravity="top"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="horizontal">

            </LinearLayout>

            <!--                <TextView-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:layout_marginBottom="@dimen/spacing_medium"-->
            <!--                    android:layout_marginTop="@dimen/spacing_large"-->
            <!--                    android:text="COUNTRY"-->
            <!--                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"-->
            <!--                    android:textColor="@color/grey_60" />-->

            <!--                <EditText-->
            <!--                    android:id="@+id/et_country"-->
            <!--                    style="@style/EditText.Flat.Grey"-->
            <!--                    android:layout_width="match_parent"-->
            <!--                    android:layout_height="@dimen/spacing_xmlarge"-->
            <!--                    android:background="@drawable/edit_text_round_bg_white"-->
            <!--                    android:drawableEnd="@drawable/ic_expand_arrow"-->
            <!--                    android:drawableRight="@drawable/ic_expand_arrow"-->
            <!--                    android:editable="false"-->
            <!--                    android:minHeight="@dimen/spacing_xmlarge"-->
            <!--                    android:paddingLeft="@dimen/spacing_middle"-->
            <!--                    android:focusable="false"-->
            <!--                    android:paddingRight="@dimen/spacing_middle"-->
            <!--                    android:text="United State" />-->


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/submitAnalysisButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginLeft="-4dp"
                android:layout_marginRight="-4dp"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="@drawable/btn_rounded_primary"
                android:text="SUBMIT ANALYSIS"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
